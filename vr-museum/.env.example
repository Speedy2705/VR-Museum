DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-secure-random-value"
AUTH_SECRET="replace-with-the-same-secure-random-value"
# Set this to the canonical HTTPS origin in production.
AUTH_URL="https://vr-museum-zkf4.vercel.app/"
# Required behind trusted reverse proxies/managed hosts. Do not enable for
# arbitrary public Host headers without configuring the proxy allow-list.
AUTH_TRUST_HOST="true"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
NEXT_PUBLIC_BLOB_UPLOADS="true"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials).
# Create a Web application client and register:
#   http://localhost:3000/api/auth/callback/google
# plus the equivalent callback URL on the production HTTPS origin.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Sign in with Apple. AUTH_APPLE_ID is the Services ID. AUTH_APPLE_SECRET is
# the signed client-secret JWT generated from the Apple Team ID, Key ID, and
# Sign in with Apple private key. Apple web callbacks require a public HTTPS
# domain; register:
#   https://your-domain.example/api/auth/callback/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Payments (test mode only). Never expose either secret key to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="replace-with-test-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-a-separate-test-webhook-secret"
# The catalog is currently USD; Razorpay UPI charges INR. Replace this fixed
# sandbox conversion with a production FX source/policy before going live.
RAZORPAY_USD_TO_INR_RATE="83"
# Server/build-time only. Used by `npm run translations:generate`.
GROQ_API_KEY=""
GROQ_TRANSLATION_MODEL="openai/gpt-oss-120b"

# Server-only. Enables the three-view image-to-3D option in the upload wizard.
MESHY_API_KEY=""
