// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ARTIST
  CURATOR
  ARCHAEOLOGIST
  RESEARCHER
  VISITOR
}

enum ListingStatus {
  ACTIVE
  SOLD
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum AssetStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ArtifactMediaType {
  IMAGE
  VIDEO
  MODEL_3D
}

enum ReportStatus {
  OPEN
  DISMISSED
  REMOVED
}

enum SupportRequestType {
  QUERY
  FEEDBACK
}

enum SupportRequestStatus {
  OPEN
  ANSWERED
}

model User {
  id               String               @id @default(cuid())
  name             String?
  email            String?              @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?
  role             UserRole?
  phone            String?              @unique
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  postalCode       String?
  country          String?
  locale           String               @default("en")
  createdAt        DateTime             @default(now())
  accounts         Account[]
  sessions         Session[]
  listings         MarketplaceListing[]
  cartItems        CartItem[]
  orders           Order[]
  uploadedAssets   UploadedAsset[]
  curatedUploads   UploadedAsset[]      @relation("UploadCurator")
  supportRequests  SupportRequest[]     @relation("SupportRequester")
  supportResponses SupportRequest[]     @relation("SupportResponder")
}

model Collection {
  id           String     @id @default(cuid())
  slug         String     @unique
  title        String
  subtitle     String
  description  String
  heroImage    String
  category     String
  translations Json       @default("{}")
  artifacts    Artifact[]
}

model Artifact {
  id               String               @id @default(cuid())
  slug             String               @unique
  title            String
  subtitle         String
  preset           String
  image            String
  videoUrl         String?
  modelUrl         String?
  modelFormat      String?
  primaryMediaType ArtifactMediaType    @default(IMAGE)
  description      String
  translations     Json                 @default("{}")
  collectionId     String
  price            Decimal?
  isForSale        Boolean              @default(false)
  collection       Collection           @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  listings         MarketplaceListing[]

  @@index([collectionId])
}

model MarketplaceListing {
  id         String        @id @default(cuid())
  artifactId String
  sellerId   String
  price      Decimal
  currency   String        @default("USD")
  status     ListingStatus @default(ACTIVE)
  artifact   Artifact      @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  seller     User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([artifactId, sellerId])
  @@index([sellerId])
}

model CartItem {
  id        String             @id @default(cuid())
  userId    String
  listingId String
  quantity  Int                @default(1)
  addedAt   DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
}

model Order {
  id                 String        @id @default(cuid())
  userId             String
  total              Decimal
  status             OrderStatus   @default(PENDING)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(PENDING)
  paymentProviderId  String?
  paymentProviderRef String?       @unique
  createdAt          DateTime      @default(now())
  user               User          @relation(fields: [userId], references: [id])
  items              OrderItem[]

  @@index([userId])
  @@index([paymentProviderId])
}

model PaymentWebhookEvent {
  id         String   @id
  provider   String
  receivedAt DateTime @default(now())

  @@index([provider])
}

model OrderItem {
  id        String             @id @default(cuid())
  orderId   String
  listingId String
  quantity  Int                @default(1)
  price     Decimal
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing   MarketplaceListing @relation(fields: [listingId], references: [id])

  @@index([orderId])
  @@index([listingId])
}

model UploadedAsset {
  id               String            @id @default(cuid())
  ownerId          String
  title            String
  category         String
  fileUrl          String
  thumbnailUrl     String?
  mediaType        ArtifactMediaType @default(MODEL_3D)
  modelFormat      String?
  status           AssetStatus       @default(PENDING)
  lightingPreset   String?
  lightTemperature String?
  lightDirection   String?
  curatorComment   String?
  curatorId        String?
  reviewedAt       DateTime?
  collectionSlug   String?
  metadata         Json
  translations     Json              @default("{}")
  views            Int               @default(0)
  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  curator          User?             @relation("UploadCurator", fields: [curatorId], references: [id], onDelete: SetNull)
  reports          ArtifactReport[]

  @@unique([ownerId, title])
  @@index([ownerId])
  @@index([curatorId])
}

model SupportRequest {
  id            String               @id @default(cuid())
  requesterId   String
  type          SupportRequestType
  subject       String
  message       String
  status        SupportRequestStatus @default(OPEN)
  response      String?
  respondedAt   DateTime?
  respondedById String?
  createdAt     DateTime             @default(now())
  requester     User                 @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  respondedBy   User?                @relation("SupportResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
}

model ArtifactReport {
  id            String         @id @default(cuid())
  uploadId      String?
  artifactTitle String
  reason        String
  details       String?
  reporterId    String?
  status        ReportStatus   @default(OPEN)
  createdAt     DateTime       @default(now())
  resolvedAt    DateTime?
  resolvedById  String?
  upload        UploadedAsset? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([uploadId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TranslationCache {
  id             String   @id @default(cuid())
  locale         String
  sourceHash     String
  sourceText     String
  translatedText String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([locale, sourceHash])
  @@index([locale])
}

model MeshySourceUpload {
  taskId    String    @id
  blobUrls  String[]
  createdAt DateTime  @default(now())
  cleanedAt DateTime?

  @@index([cleanedAt])
}
